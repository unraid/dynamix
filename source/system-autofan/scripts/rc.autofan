#!/bin/bash
#=======================================================================================
#  Name:  rc.autofan
#=======================================================================================
#  Description:
#
#  This script has the aim to control autofan script
#  How to invoke in your "go" script (copy to /boot/scripts):
#  chmod +x /boot/scripts/fan_speed.sh -- superseeded by Dynamix plugin
#  /boot/fan_speed.sh                  -- superseeded by Dynamix plugin
#=======================================================================================
# Version 1.0   Authored by Aiden
# Version 1.1   Modified by Dan Stroot to run in a loop. Does not require the user
#               to add this to cron     - just start it in your go file.
# Version 1.2   Modified by Guzzi       - removed -d ata to work on sas controllers
# Version 1.3   Modified by gfjardim    - added to dynamix.system.autofan
# Version 1.4   Modified by Bergware    - added additional line parameters
#                                       - start/stop control by Dynamix plugin
#                                       - celsius/fahrenheit conversion
# Version 1.5   Modified by Bergware    - added nvme devices temperature reading (contributed by syntactic-salt)
#                                       - added exclude disks from temperature reading (contributed by andreiio)
# Version 1.6   Modified by InfinityMod - added multifan support
#                                       - added fan spin up/down offset
# Version 1.7   Modified by mrjacobarussell - stable hwmon path resolution by device name
#                                           - resolves USB hwmon number changes across reboots
plugin=dynamix.system.autofan
script=autofan
execute=/usr/local/emhttp/plugins/$plugin/scripts/$script
cfg_path=/boot/config/plugins/$plugin

# Find the current hwmon directory for a device by its kernel name.
# hwmon numbers (hwmon0, hwmon1, ...) can change each reboot for USB devices.
# If hwmon_name is set in cfg, this resolves the correct current path.
resolve_hwmon() {
  local name="$1"
  local match
  match=$(grep -rlx "$name" /sys/class/hwmon/*/name 2>/dev/null | head -1)
  [[ -n $match ]] && dirname "$match"
}

# Substitute stale hwmon dir in a string with the current resolved dir.
# Uses the saved controller path to identify which hwmonN was stored,
# then replaces ALL occurrences in the target string (covers -c, -f, -s flags).
resolve_hwmon_in_string() {
  local str="$1" hwmon_name="$2" saved_controller="$3"
  if [[ -n $hwmon_name && -n $saved_controller ]]; then
    local current_dir saved_dir
    current_dir=$(resolve_hwmon "$hwmon_name")
    saved_dir=$(dirname "$saved_controller")
    if [[ -n $current_dir && -n $saved_dir && "$saved_dir" != "$current_dir" ]]; then
      str="${str//$saved_dir/$current_dir}"
    fi
  fi
  echo "$str"
}

autofan.start() {
  for cfg in $cfg_path/$plugin*.cfg; do
    source $cfg
    if [[ $service == 1 ]]; then
      local resolved_options
      resolved_options=$(resolve_hwmon_in_string "$options" "$hwmon_name" "$controller")
      $execute $resolved_options 1>/dev/null 2>&1
      echo "$script started"
    fi
  done
}

autofan.stop() {
  for cfg in $cfg_path/$plugin*.cfg; do
    source $cfg
    local rc fan_path
    rc=$(resolve_hwmon_in_string "$controller" "$hwmon_name" "$controller")
    fan_path=$(resolve_hwmon_in_string "$fan" "$hwmon_name" "$controller")
    $execute -c $rc -f $fan_path -q 1>/dev/null 2>&1
    timer=5
    until [[ -z $(pgrep -f $execute) || $timer -eq 0 ]]; do
      timer=$((timer-1))
      sleep 1
    done
    # set fan to max
    [[ -f $rc ]] && echo 255 > $rc
    echo "$script stopped"
  done
}

autofan.speed() {
  for cfg in $cfg_path/$plugin*.cfg; do
    source $cfg
    local rc fan_path
    rc=$(resolve_hwmon_in_string "$controller" "$hwmon_name" "$controller")
    fan_path=$(resolve_hwmon_in_string "$fan" "$hwmon_name" "$controller")
    [[ -f $rc && $(cat $fan_path) -gt 0 ]] && echo -n "$(($(($(cat $rc)*100))/255)) " || echo -n "0 "
  done
}

autofan.restart() {
  autofan.stop
  sleep 2
  autofan.start
}

case "$1" in
'start')
 autofan.start ;;
'stop')
 autofan.stop ;;
'speed')
 autofan.speed ;;
'restart')
 autofan.restart ;;
*)
 echo "Usage: $(basename $0) start|stop|restart|speed"
esac
