<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "dynamix.system.autofan">
<!ENTITY author    "mrjacobarussell (Enhanced Fork, based on Bergware/gfjardim)">
<!ENTITY version   "2025.06.11">
<!ENTITY launch    "Settings/FanSettings">
<!ENTITY pluginURL "https://raw.githubusercontent.com/mrjacobarussell/dynamix/corsair-commander-pro/unRAIDv6/&name;.plg">
<!ENTITY source    "/boot/config/plugins/&name;/&name;">
<!ENTITY MD5       "9b42252d6a25a68b0e031f108690d363">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.9.0" icon="dynamix.system.autofan.png" support="https://github.com/mrjacobarussell/dynamix/issues">

<CHANGES>
##Dynamix System Autofan (Enhanced Fork)

###2025.06.11 (mrjacobarussell)
- FanSettings page: show the Dashboard Fan Labels custom name (if set) next to the PWM controller dropdown
- FanSettings page: center-align all field labels and inputs

###2025.06.10c (mrjacobarussell)
- Fix description text: README headings (# ## ###) rendered oversized on Plugins page, shifting layout. Converted to bold.

###2025.06.10b (mrjacobarussell)
- Version bump (no functional change)

###2025.06.10a (mrjacobarussell)
- Recolor plugin icon to light blue

###2025.06.10 (mrjacobarussell)
- Rebrand: program name now "AutoFan Enhanced Fork by mrjacobarussell"
- Add plugin icon and description for Plugins page
- Update author/support links

###2025.06.09 (mrjacobarussell)
- Add hardware sensor probe temperature source (Corsair Commander Pro, hwmon sensors)
- Stable hwmon device name resolution for USB controllers (fixes path loss after reboot)
- New UI: Temperature source dropdown, sensor picker, stable device name field
- Drive filter mode toggle (include/exclude selected drives)
- Fix fan detect to only consider fans on same hwmon chip as selected PWM controller
- Fan picker dropdown filtered by chip replaces free-text input

###2025.11.14 (upstream)
- Migrate repository to Unraid

###2023.02.05a
- set minimum Unraid version to 6.9 (supports multi-language)
- added support for upcoming Unraid version 6.12 

###2022.09.16
- added SAS disks support (courtesy of user Doron)
- minor updates

###2020.06.21
- fixed regression error

###2020.06.20
- updated multi-language support

###2020.05.10
- updated multi-language support

###2020.04.11
- fixed NMVE exclusion (courtesy of Leoyzen)

###2020.03.31
- added multi-language support
- added multi fan selection

###2017.10.15
- added temperature reading from NVMe devices (contributed by syntactic-salt)
- added exclude disks option from temperature reading (contributed by andreiio)

###2016.12.15
- fixed incompatibility with PHP7

###2016.08.26
- fixed folders and files permissions
- added minimum unRAID version 6.1.9

###2016.03.15
- fixed temperature input when Fahrenheit is selected
- fixed log notifications in Celsius or Fahrenheit

###2016.02.27
- added display of autofan speed percentage when system temp is installed (courtesy of gfjardim)

###2015.12.14
- added unRAID version check. Only version 6.1 or higher is allowed
- updated consistency of PLG file

###2015.12.13
- changed .txz file naming to support consistent package upgrading
- updated rc.autofan script (start | stop | restart)
- fixed autofan script start

###2015.08.13
- adhere new security policy in unRAID v6.1 (please reboot after upgrade)
- correction in display of detection progress

###2015.08.08
- made plugin compatible for unRAID version 6.0 and 6.1

###2015.06.27
- removed utilities page (now standard included with Dynamix webGui)
- removed Reset button (now controlled by Dynamix webGui)
- added Default button

###2015.04.28
- added Reset button on settings page

###2015.04.11
- improved pwm scanning (thanks to gfjardim)

###2015.02.07
- initial release for unRAID v6
</CHANGES>

<!--
Copyright 2023, Bergware International
Dynamix System Autofan - Fan speed control. Makes use of autofan script contributed by Aiden, Dan Stroot, Guzzi, gfjardim
-->

<!-- PRE-INSTALL SCRIPT -->
<FILE Run="/bin/bash">
<INLINE>
# Stop service
/usr/local/emhttp/plugins/&name;/scripts/rc.autofan stop 2>/dev/null

# Remove old 'source' packages
MD5=$(md5sum &source;.txz 2>/dev/null|grep -Po '^\S+')
if [[ $MD5 != &MD5; ]]; then
  rm -f &source;*.txz
fi
</INLINE>
</FILE>

<!-- SOURCE PACKAGE -->
<FILE Name="&source;.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/mrjacobarussell/dynamix/releases/download/2025.06.09/dynamix.system.autofan.txz</URL>
<MD5>&MD5;</MD5>
</FILE>

<!-- WORKAROUND -->
<FILE Name="/tmp/start_service" Mode="0770">
<INLINE>
#!/bin/bash
/usr/local/emhttp/plugins/&name;/scripts/rc.autofan start 2>/dev/null
</INLINE>
</FILE>

<!-- POST-INSTALL SCRIPT -->
<FILE Run="/bin/bash">
<INLINE>
cfg=&source;.cfg
if [[ ! -e $cfg ]]; then
  cfg=/usr/local/emhttp/plugins/&name;/default.cfg
fi

# Start service
enable=$(grep -Po '^service="\K[^"]+' $cfg)
if [[ $enable -eq 1 ]]; then
  at -M -f /tmp/start_service now 2>/dev/null
fi
rm -f /tmp/start_service

echo ""
echo "-----------------------------------------------------------"
echo " Plugin &name; is installed."
echo " This plugin requires Dynamix webGui to operate"
echo " Copyright 2023, Bergware International"
echo " Enhanced fork by mrjacobarussell"
echo " Version: &version;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- REMOVE SCRIPT -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Stop service
/usr/local/emhttp/plugins/&name;/scripts/rc.autofan stop 2>/dev/null

# Remove plugin related files
rm -rf /boot/config/plugins/&name;

# Uninstall the 'source' package
removepkg &name;
</INLINE>
</FILE>

</PLUGIN>